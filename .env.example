# 复制为 .env 并填入你的配置（.env 已被 gitignore）
LLM_API_KEY=
# DashScope 用户也可以填写此项；设置后优先于 LLM_API_KEY
DASHSCOPE_API_KEY=your-dashscope-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# V2 高层 NPC Planner；Runtime 的 Tool/Rule/Gate 不随策略切换
NOVELSIM_PLANNER_POLICY=scripted
NOVELSIM_PLANNER_FALLBACK=scripted
NOVELSIM_PLANNER_TIMEOUT_SECONDS=3.0

# 本机若有 Clash 类代理导致 SSLEOFError，设为 * 直连
NO_PROXY=*

# 可选：世界状态与事件数据库，默认 data/world.sqlite3
WORLD_DB_PATH=data/world.sqlite3
# 生产环境设置后切换 PostgreSQL + pgvector；本地 SQLite 时留空
WORLD_DATABASE_URL=

# 可选：SQLite 继续保存权威数据，Qdrant 只保存可重建的语义索引
# 安装：.venv/Scripts/python.exe -m pip install -e ".[qdrant]"
MEMORY_VECTOR_BACKEND=qdrant
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=character_memories
# 若改用 Qdrant Server/Cloud，填写 URL 后会忽略 QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=

# DashScope OpenAI兼容embedding；官方推荐通用场景使用1024维
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
# embedding 服务与聊天模型不同时，必须显式填写下面两项
# 未设置时复用 LLM_API_KEY / DASHSCOPE_API_KEY 与 LLM_BASE_URL
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=

# 每 5 个世界版本尝试把至少 3 条新情景记忆提炼为带证据链的反思
MEMORY_REFLECTIONS_ENABLED=true
MEMORY_REFLECTION_INTERVAL=5
MEMORY_REFLECTION_MIN_EPISODES=3
MEMORY_REFLECTION_SEMANTIC_JUDGE_ENABLED=true
MEMORY_REFLECTION_SEMANTIC_THRESHOLD=0.72

# 小说编译任务控制面；仍使用 SQLite，无需 Docker
COMPILER_DB_PATH=data/compiler.sqlite3
COMPILER_QUALITY_GATE_ENABLED=true

# 创作者账户、Bearer 令牌和审核审计
AUTH_DB_PATH=data/auth.sqlite3

# 创作者后台保存的世界包目录
WORLD_PACKAGE_DIR=worlds
