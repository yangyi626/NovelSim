# 复制为 .env 并填入你的配置（.env 已被 gitignore）
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.gpt.ge/v1
LLM_MODEL=qwen3.6-plus

# 本机若有 Clash 类代理导致 SSLEOFError，设为 * 直连
NO_PROXY=*

# 可选：世界状态与事件数据库，默认 data/world.sqlite3
WORLD_DB_PATH=data/world.sqlite3
# 生产环境设置后切换 PostgreSQL + pgvector；本地 SQLite 时留空
WORLD_DATABASE_URL=

# 可选：SQLite 继续保存权威数据，Qdrant 只保存可重建的语义索引
# 安装：.venv/Scripts/python.exe -m pip install -e ".[qdrant]"
MEMORY_VECTOR_BACKEND=qdrant
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=character_memories
# 若改用 Qdrant Server/Cloud，填写 URL 后会忽略 QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=

# 当前网关已验证 text-embedding-3-small 返回 1536 维向量
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
# 未设置时复用 LLM_API_KEY / LLM_BASE_URL
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=

# 每 5 个世界版本尝试把至少 3 条新情景记忆提炼为带证据链的反思
MEMORY_REFLECTIONS_ENABLED=true
MEMORY_REFLECTION_INTERVAL=5
MEMORY_REFLECTION_MIN_EPISODES=3

# 创作者后台保存的世界包目录
WORLD_PACKAGE_DIR=worlds
