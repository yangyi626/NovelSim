{
  "contract_version": "1.0.0",
  "stability": "stable",
  "compatibility_policy": {
    "minor": "1.x 内不得删除已有路径、方法、请求字段或响应字段",
    "additive": "允许新增可选请求字段和可忽略响应字段",
    "breaking": "破坏性变更必须提升主版本"
  },
  "security": {
    "creator": "Bearer token",
    "roles": ["creator", "reviewer", "publisher", "admin"]
  },
  "endpoints": {
    "/health": ["GET"],
    "/ready": ["GET"],
    "/api/meta/contract": ["GET"],
    "/api/auth/bootstrap": ["POST"],
    "/api/auth/login": ["POST"],
    "/api/auth/me": ["GET"],
    "/api/admin/users": ["GET", "POST"],
    "/api/admin/users/{user_id}": ["PATCH"],
    "/api/start": ["POST"],
    "/api/worlds": ["GET"],
    "/api/world-runs/{session_id}/dashboard": ["GET"],
    "/api/world-runs/{session_id}/settlement": ["GET", "POST"],
    "/api/world-runs/{session_id}/settlements": ["GET", "POST"],
    "/api/world-runs/{session_id}/settle": ["POST"],
    "/api/world-runs/{session_id}/transitions": ["POST"],
    "/api/world-runs/{session_id}/lineage": ["GET"],
    "/api/campaigns/{campaign_id}/progression": ["GET"],
    "/api/scenes/secret-letter/runs": ["POST"],
    "/api/session": ["GET"],
    "/api/player-view": ["GET"],
    "/api/turn": ["POST"],
    "/api/manuscript/retry": ["POST"],
    "/api/manuscript/passages/{passage_id}/revisions": ["GET"],
    "/api/manuscript/passages/{passage_id}/select-revision": ["POST"],
    "/api/manuscript/passages/{passage_id}/retry": ["POST"],
    "/api/saves": ["GET"],
    "/api/saves/{session_id}": ["PATCH", "DELETE"],
    "/api/saves/clear-history": ["POST"],
    "/api/saves/{session_id}/export": ["GET"],
    "/api/saves/import": ["POST"],
    "/api/creator/compiler/jobs": ["GET", "POST"],
    "/api/creator/compiler/jobs/{job_id}": ["GET"],
    "/api/creator/compiler/jobs/{job_id}/report": ["GET"],
    "/api/creator/compiler/jobs/{job_id}/actions": ["POST"],
    "/api/creator/compiler/jobs/{job_id}/budget": ["POST"],
    "/api/creator/packages": ["GET"],
    "/api/creator/packages/validate": ["POST"],
    "/api/creator/packages/{package_id}": ["GET", "PUT"],
    "/api/creator/packages/{package_id}/clone": ["POST"],
    "/api/creator/packages/{package_id}/revisions": ["GET"],
    "/api/creator/packages/{package_id}/diff": ["GET"],
    "/api/creator/packages/{package_id}/review": ["POST"],
    "/api/creator/audit": ["GET"],
    "/api/state": ["GET"],
    "/api/events": ["GET"],
    "/api/joint-plans": ["GET"],
    "/api/joint-plans/generate": ["POST"],
    "/api/joint-plans/abort-active": ["POST"],
    "/api/joint-plans/{plan_id}": ["PUT"],
    "/api/joint-plans/{plan_id}/approve": ["POST"],
    "/api/joint-plans/{plan_id}/execute": ["POST"],
    "/api/presentation-snapshot": ["GET"],
    "/api/presentation-events": ["GET"]
  },
  "invariants": [
    "WorldState 与 WorldEvent 是运行时权威事实",
    "小说稿件是可重建派生数据；生成或重试失败不得回滚事件，稿件不得反向修改权威世界状态",
    "健康 ready 稿件只能在显式 rewrite_ready 且 expected_revision 匹配时追加新 revision；重写不得重放事件或改写权威世界状态",
    "稿件 revision 历史不可变；选择旧 revision 只切换 passage 当前指针，不删除历史记录",
    "正常 /api/turn 响应始终携带当前权威 WorldState；拒绝回合不提交事件且版本不变",
    "LLM 只能提出 Action、StatePatch 与表现文本",
    "Web 联合计划必须经过 draft -> approved 才能进入受限工具执行器；编辑规划不得直接提交 WorldState",
    "编译任务由 SQLite 队列与独立 Worker 执行",
    "Qdrant 是可重建派生索引",
    "发布必须经过 approved -> published 权限转换",
    "编译任务绑定创建时的 raw_bytes 源文件指纹，源文件变化时不得继续混编或发布",
    "编译任务预算只能追加已用调用次数不变，失败任务仅在明确 retryable 且未超过重试上限时重试",
    "编译任务报告接口只读任务数据库，不因 GET 查询改写报告文件",
    "Unity 表现命令由已提交 WorldEvent 稳定投影，客户端按 sequence 幂等确认"
  ]
}
